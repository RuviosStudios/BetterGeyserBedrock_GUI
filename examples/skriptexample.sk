# BGB_GUI Skript-Beispiel
# Braucht: Skript + BGB_GUI + Geyser/Floodgate (+ skript-reflect für import:)
# Java/Bedrock prüft BGB_GUI nicht — Forms gehen nur an Bedrock-Spieler.
#
# Empfohlen: Multiline-Sections (Einrückung). Einzeiler bleiben gültig.
# Wichtig: Jedes Formular braucht eine eigene ID (id: "...")

import:
    org.geysermc.floodgate.api.FloodgateApi

options:
    prefix: &8[&6BGB_GUI&8]&r


function isBedrock(p: player) :: boolean:
    return FloodgateApi.getInstance().isFloodgatePlayer(uuid of {_p})


# Simple ohne Buttons: nur Titel + Text (schließen über X)
command /bgbexample:
    permission: bgbgui.example
    trigger:
        if isBedrock(player) is true:
            open simple form to player:
                id: "textexample"
                title: "TextExample"
                description: "Test Text"

# --- Simple Form: Shop ---
# button: "Text" [with image "url|path"]
# http(s) = URL, sonst Resource-Pack-Pfad
command /bgbshop:
    permission: bgbgui.example
    trigger:
        if isBedrock(player) is true:
            open simple form to player:
                id: "shop"
                title: "Shop"
                description: "Was möchtest du?"
                button: "Diamant kaufen" with image "textures/items/diamond"
                button: "Diamant verkaufen" with image "textures/items/gold_ingot"
                button: "Hilfe" with image "https://www.skydinse.net/skydinse/logo.png"
                button: "Abbruch"

on bgb simple form with id "shop":
    if form button is "Diamant kaufen":
        give 1 diamond to player
        send "{@prefix} &aDu hast einen Diamanten bekommen." to player
    else if form button is "Diamant verkaufen":
        if player has 1 diamond:
            remove 1 diamond from player's inventory
            give 5 gold ingot to player
            send "{@prefix} &e1 Diamant verkauft, 5 Goldbarren erhalten." to player
        else:
            send "{@prefix} &cDu hast keinen Diamanten." to player
    else if form button is "Hilfe":
        send "{@prefix} &7Kaufen kostet nichts, verkaufen bringt Gold." to player
    else:
        send "{@prefix} &7Shop geschlossen." to player

# --- Modal Form: Heilen ---
command /bgbheal:
    permission: bgbgui.example
    trigger:
        if isBedrock(player) is true:
            open modal form to player:
                id: "heal"
                title: "Heilen?"
                description: "HP und Hunger voll machen?"
                yes: "Ja, heilen"
                no: "Nein"

on bgb modal form with id "heal":
    if form yes is true:
        heal player
        feed player
        apply regeneration 1 to player for 5 seconds
        send "{@prefix} &aDu wurdest geheilt." to player
        send title "&aGeheilt" with subtitle "&7volles Leben & Hunger" to player for 2 seconds
    else:
        send "{@prefix} &7Nicht geheilt." to player

# --- Custom Form: Einstellungen (label/input/dropdown/toggle/slider) ---
# Kurzform input: "Name" bleibt gültig (id = label).
command /bgbsettings:
    permission: bgbgui.example
    trigger:
        if isBedrock(player) is true:
            open custom form to player:
                id: "settings"
                title: "Einstellungen"
                label: "Bitte ausfüllen"
                input: "name" labeled "Name" with placeholder "Spieler"
                dropdown: "color" labeled "Farbe" with options "Rot", "Grün" and "Blau"
                toggle: "notify" labeled "Benachrichtigungen" with default true
                slider: "volume" labeled "Lautstärke" from 0 to 10 with default 5

on bgb custom form with id "settings":
    set {_name} to form value of "name"
    set {_color} to form value of "color"
    set {_notify} to form value of "notify"
    set {_volume} to form value of "volume"

    if {_name} is not set:
        send "{@prefix} &cBitte einen Namen eintragen." to player
        stop
    if {_name} is "":
        send "{@prefix} &cBitte einen Namen eintragen." to player
        stop

    set {_colors::0} to "Rot"
    set {_colors::1} to "Grün"
    set {_colors::2} to "Blau"
    set {_colorName} to {_colors::%{_color}%}
    if {_colorName} is not set:
        set {_colorName} to "unbekannt"

    set {bgb::name::%uuid of player%} to {_name}
    set {bgb::color::%uuid of player%} to {_colorName}
    set {bgb::notify::%uuid of player%} to {_notify}
    set {bgb::volume::%uuid of player%} to {_volume}

    set display name of player to "&e%{_name}%"
    set tab list name of player to "&e%{_name}%"

    send title "&e%{_name}%" with subtitle "&7%{_colorName}% · Lautstärke %{_volume}%" to player for 3 seconds
    send "{@prefix} &aGespeichert: &e%{_name}%&a, Farbe &e%{_colorName}%&a (Index %{_color}%), Notify &e%{_notify}%&a, Volume &e%{_volume}%&a." to player

command /bgbmeinprofil:
    permission: bgbgui.example
    trigger:
        if {bgb::name::%uuid of player%} is not set:
            send "{@prefix} &cNoch kein Profil. Nutze &e/bgbsettings" to player
            stop
        send "{@prefix} &fName: &e%{bgb::name::%uuid of player%}%&f | Farbe: &e%{bgb::color::%uuid of player%}%&f | Notify: &e%{bgb::notify::%uuid of player%}%&f | Volume: &e%{bgb::volume::%uuid of player%}%" to player
